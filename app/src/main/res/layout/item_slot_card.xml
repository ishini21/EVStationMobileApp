<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slotCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeColor="#10B981"
    app:strokeWidth="3dp">

    <LinearLayout
        android:id="@+id/cardContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_background_available">

        <!-- Header with charging plug icon and slot ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_charging_plug"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvSlotId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WP-CMB-007-S1"
                android:textSize="16sp"
                android:textColor="#000000"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_checkmark_circle"
                android:visibility="visible"/>

        </LinearLayout>

        <!-- Slot Details -->
        <TextView
            android:id="@+id/tvConnectorType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connector: CHAdeMO_CCS2_DualPort"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Power: kW50"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price/kWh: Rs. 80"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <!-- Status Badge and Edit Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/statusBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_background_available"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:id="@+id/ivStatusBadgeIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_checkmark_circle"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvSlotStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btnEditStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="EDIT STATUS"
                android:textSize="10sp"
                android:textColor="#000000"
                android:background="@drawable/profile_field_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:drawableStart="@drawable/ic_edit_status"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:drawableTint="#6B7280"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
