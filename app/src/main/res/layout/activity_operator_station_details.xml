<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5F0"
    tools:context=".activities.OperatorStationDetailsActivity">

    <View
        android:id="@+id/headerBanner"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#10B981"
        android:layout_alignParentTop="true" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:background="@drawable/back_button_bg"
        android:clickable="true"
        android:focusable="true"
        app:tint="#000000"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"/>

    <!-- Station Info in Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:layout_marginTop="80dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvStationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pettah Fast DC Charger"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_background_1"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/tvStationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="12sp"
                    android:textColor="#10B981"
                    android:background="@drawable/bg_status_confirmed"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvStationId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(WP-CMB-007)"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:alpha="0.9"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="140dp"
        android:layout_above="@id/bottom_navigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Station Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:backgroundTint="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Station Info Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:backgroundTint="#F9FAFB">
                            <LinearLayout 
                                android:layout_width="match_parent" 
                                android:layout_height="wrap_content" 
                                android:orientation="vertical" 
                                android:padding="16dp">
                                <ImageView 
                                    android:layout_width="24dp" 
                                    android:layout_height="24dp" 
                                    android:src="@drawable/ic_lightning_bolt" 
                                    android:layout_marginBottom="8dp"/>
                                <TextView 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="Station Type" 
                                    android:textSize="12sp" 
                                    android:textColor="#6B7280" 
                                    android:layout_marginBottom="4dp"/>
                                <TextView 
                                    android:id="@+id/tvStationType" 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="DC" 
                                    android:textSize="16sp" 
                                    android:textColor="#000000" 
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:backgroundTint="#F9FAFB">
                            <LinearLayout 
                                android:layout_width="match_parent" 
                                android:layout_height="wrap_content" 
                                android:orientation="vertical" 
                                android:padding="16dp">
                                <ImageView 
                                    android:layout_width="24dp" 
                                    android:layout_height="24dp" 
                                    android:src="@drawable/ic_charging_adapter" 
                                    android:layout_marginBottom="8dp"/>
                                <TextView 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="Total Slots" 
                                    android:textSize="12sp" 
                                    android:textColor="#6B7280" 
                                    android:layout_marginBottom="4dp"/>
                                <TextView 
                                    android:id="@+id/tvTotalSlots" 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="3" 
                                    android:textSize="16sp" 
                                    android:textColor="#000000" 
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:backgroundTint="#F9FAFB">
                            <LinearLayout 
                                android:layout_width="match_parent" 
                                android:layout_height="wrap_content" 
                                android:orientation="vertical" 
                                android:padding="16dp">
                                <ImageView 
                                    android:layout_width="24dp" 
                                    android:layout_height="24dp" 
                                    android:src="@drawable/ic_phone_receiver" 
                                    android:layout_marginBottom="8dp"/>
                                <TextView 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="Phone" 
                                    android:textSize="12sp" 
                                    android:textColor="#6B7280" 
                                    android:layout_marginBottom="4dp"/>
                                <TextView 
                                    android:id="@+id/tvStationPhone" 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="0705638245" 
                                    android:textSize="16sp" 
                                    android:textColor="#000000" 
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:backgroundTint="#F9FAFB">
                            <LinearLayout 
                                android:layout_width="match_parent" 
                                android:layout_height="wrap_content" 
                                android:orientation="vertical" 
                                android:padding="16dp">
                                <ImageView 
                                    android:layout_width="24dp" 
                                    android:layout_height="24dp" 
                                    android:src="@drawable/ic_clock" 
                                    app:tint="#10B981" 
                                    android:layout_marginBottom="8dp"/>
                                <TextView 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="Operating Hours" 
                                    android:textSize="12sp" 
                                    android:textColor="#6B7280" 
                                    android:layout_marginBottom="4dp"/>
                                <TextView 
                                    android:id="@+id/tvOperatingHours" 
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content" 
                                    android:text="16:00 - 12:00" 
                                    android:textSize="16sp" 
                                    android:textColor="#000000" 
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Full Location Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:backgroundTint="#F9FAFB">
                        <LinearLayout 
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content" 
                            android:orientation="vertical" 
                            android:padding="16dp">
                            <ImageView 
                                android:layout_width="24dp" 
                                android:layout_height="24dp" 
                                android:src="@drawable/ic_location" 
                                app:tint="#10B981" 
                                android:layout_marginBottom="8dp"/>
                            <TextView 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" 
                                android:text="Full Location" 
                                android:textSize="12sp" 
                                android:textColor="#6B7280" 
                                android:layout_marginBottom="4dp"/>
                            <TextView 
                                android:id="@+id/tvFullLocation" 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" 
                                android:text="148/15, Lesley Ranagala Mawatha, Colombo 08" 
                                android:textSize="14sp" 
                                android:textColor="#000000" 
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>
                            <TextView 
                                android:id="@+id/tvCoordinates" 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content" 
                                android:text="Lat: 6.9357 | Lon: 79.8549" 
                                android:textSize="12sp" 
                                android:textColor="#6B7280"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Assigned Operators Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned Operators"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/operatorsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="20dp" />

            </HorizontalScrollView>

            <!-- Available Slots Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Slots"
                android:textSize="20sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/slotsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingEnd="20dp" />

            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="?android:attr/windowBackground"
        app:menu="@menu/station_bottom_nav_menu" />

</RelativeLayout>
